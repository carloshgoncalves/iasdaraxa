{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Aguardar Xdebug (WampServer)",
            "type": "php",
            "request": "launch",
            "port": 9003,
            "pathMappings": {
                "C:\\wamp64\\www\\iasdaraxa": "${workspaceFolder}"
            }
        },
        {
            "name": "Executar arquivo PHP atual",
            "type": "php",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "runtimeExecutable": "C:\\wamp64\\bin\\php\\php8.4.15\\php.exe",
            "port": 0
        }
    ]
}
